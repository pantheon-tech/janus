# Environment configuration — rename to .env.local and fill in values.
# .env.local is gitignored; .env.example is the committed template.
# Every variable used by the app must be documented here.

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=info

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=          # user-assigned managed identity client id (for local az login)

# --- Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Key Vault ---
KEY_VAULT_URI=            # https://kv-{{workload}}-staging.vault.azure.net/

# --- Database (Cosmos DB example) ---
COSMOS_ENDPOINT=
COSMOS_KEY=               # local dev only; prod uses managed identity

# --- Auth (MSAL) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_API_SCOPE=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=service.name={{workload}}-api,service.version=0.1.0
