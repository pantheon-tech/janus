name: Deploy

# Single workflow file. Branch-aware:
#   staging push -> staging environment
#   main push    -> prod environment (gated by GitHub Environment required reviewers)
#
# Release-please runs only after a successful prod deploy.

on:
  push:
    branches: [staging, main]

permissions:
  id-token: write
  contents: read

concurrency:
  group: deploy-${{ '{{' }} github.ref_name {{ '}}' }}
  cancel-in-progress: false  # never cancel an in-flight deploy

jobs:
  resolve-env:
    runs-on: ubuntu-latest
    outputs:
      env: ${{ '{{' }} steps.set.outputs.env {{ '}}' }}
    steps:
      - id: set
        run: |
          case "${{ '{{' }} github.ref_name {{ '}}' }}" in
            main)    echo "env=prod"    >> "$GITHUB_OUTPUT" ;;
            staging) echo "env=staging" >> "$GITHUB_OUTPUT" ;;
            *)       echo "Unknown branch: ${{ '{{' }} github.ref_name {{ '}}' }}"; exit 1 ;;
          esac

  deploy:
    needs: resolve-env
    runs-on: ubuntu-latest
    environment: ${{ '{{' }} needs.resolve-env.outputs.env {{ '}}' }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2

      - uses: pnpm/action-setup@8b2eead6074fefa43a68bf4c9e0f03ea4126b5ba  # v6.0.3
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e  # v6.4.0
        with:
          node-version: '24'
          cache: 'pnpm'

      - run: pnpm install --frozen-lockfile
      - run: pnpm build

      - uses: azure/login@2dd0bbf4064d5a1812889dc200bb8eed2597f82a  # v3
        with:
          client-id: ${{ '{{' }} secrets.AZURE_CLIENT_ID {{ '}}' }}
          tenant-id: ${{ '{{' }} secrets.AZURE_TENANT_ID {{ '}}' }}
          subscription-id: ${{ '{{' }} secrets.AZURE_SUBSCRIPTION_ID {{ '}}' }}

      - name: Deploy
        run: ./infra/deploy.sh ${{ '{{' }} needs.resolve-env.outputs.env {{ '}}' }}

      - name: Health check
        run: ./infra/scripts/health-check.sh ${{ '{{' }} needs.resolve-env.outputs.env {{ '}}' }}

  release:
    # Only run release-please on successful prod deploys
    needs: [resolve-env, deploy]
    if: needs.resolve-env.outputs.env == 'prod' && needs.deploy.result == 'success'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7  # v5.0.0
        with:
          # For monorepos, omit release-type and ship release-please-config.json
          # in the repo root (manifest mode). For single-package, this single arg suffices.
          release-type: node
