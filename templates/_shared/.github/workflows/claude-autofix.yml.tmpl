{{=<% %>=}}
name: Claude Autofix

# Fail-soft pattern: when CI fails on a PR, capture logs, open a `claude-fix`
# labelled issue (or update existing), tag @claude. Cooldown + open-PR dedup
# prevent spam loops.
#
# Adapted from the ae-option pattern.

on:
  workflow_run:
    workflows: ['CI']
    types: [completed]

permissions:
  contents: read
  issues: write
  pull-requests: write
  actions: read

concurrency:
  group: autofix-${{ github.event.workflow_run.pull_requests[0].number || github.event.workflow_run.id }}
  cancel-in-progress: false

jobs:
  open-fix-issue:
    # Only fire on PR-failure runs from same-repo PRs (fork PRs have an empty
    # pull_requests array under GITHUB_TOKEN, which would create a malformed
    # issue with "PR #").
    if: >-
      github.event.workflow_run.conclusion == 'failure'
      && github.event.workflow_run.event == 'pull_request'
      && github.event.workflow_run.pull_requests[0] != null
      && github.event.workflow_run.head_repository.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2

      - name: Cooldown check
        id: cooldown
        env:
          # ACTIONS_PAT (PAT with repo scope) is required so the issue we open
          # actually triggers the @claude workflow downstream — events created
          # by GITHUB_TOKEN do not cascade into other workflows.
          GH_TOKEN: ${{ secrets.ACTIONS_PAT || github.token }}
          PR_NUMBER: ${{ github.event.workflow_run.pull_requests[0].number }}
        run: |
          # 30-minute cooldown per PR + open-PR dedup
          MARKER="<!-- claude-autofix:pr:$PR_NUMBER -->"
          EXISTING=$(gh issue list --search "in:body \"$MARKER\"" --state open \
            --json number,createdAt --jq '.[0]' 2>/dev/null || echo "")
          if [ -n "$EXISTING" ]; then
            CREATED=$(echo "$EXISTING" | jq -r '.createdAt')
            AGE_SECS=$(( $(date -u +%s) - $(date -d "$CREATED" +%s) ))
            if [ "$AGE_SECS" -lt 1800 ]; then
              echo "skip=true" >> "$GITHUB_OUTPUT"
              echo "Cooldown active (issue $(echo "$EXISTING" | jq -r '.number') opened ${AGE_SECS}s ago); skipping"
              exit 0
            fi
          fi
          echo "skip=false" >> "$GITHUB_OUTPUT"
          echo "marker=$MARKER" >> "$GITHUB_OUTPUT"

      - name: Capture failed logs
        if: steps.cooldown.outputs.skip == 'false'
        id: logs
        env:
          GH_TOKEN: ${{ secrets.ACTIONS_PAT || github.token }}
          RUN_ID: ${{ github.event.workflow_run.id }}
        run: |
          LOG=$(gh run view "$RUN_ID" --log-failed 2>&1 | head -200 || echo "(log capture failed)")
          {
            echo "log<<LOGEOF"
            echo "$LOG"
            echo "LOGEOF"
          } >> "$GITHUB_OUTPUT"

      - name: Create or update fix issue
        if: steps.cooldown.outputs.skip == 'false'
        env:
          # Must be ACTIONS_PAT — issues created via GITHUB_TOKEN do not trigger
          # the claude.yml workflow that listens for @claude mentions.
          GH_TOKEN: ${{ secrets.ACTIONS_PAT || github.token }}
          PR_NUMBER: ${{ github.event.workflow_run.pull_requests[0].number }}
          RUN_URL: ${{ github.event.workflow_run.html_url }}
          MARKER: ${{ steps.cooldown.outputs.marker }}
          LOG: ${{ steps.logs.outputs.log }}
        run: |
          # Use a temp file to avoid heredoc EOF-injection risk: if $LOG contains
          # a line starting with the heredoc terminator, the shell would truncate
          # the body and treat the remainder as commands. Writing to a file and
          # using --body-file eliminates that attack surface entirely.
          TMPBODY=$(mktemp)
          trap 'rm -f "$TMPBODY"' EXIT
          printf '@claude CI failed on PR #%s. Please review the logs and push a fix to the PR branch.\n\n**Run**: %s\n\n**Failed step output (truncated)**:\n```\n%s\n```\n\n%s\n' \
            "$PR_NUMBER" "$RUN_URL" "$LOG" "$MARKER" > "$TMPBODY"
          gh issue create \
            --title "[claude-fix] CI failure on PR #$PR_NUMBER" \
            --body-file "$TMPBODY" \
            --label "claude-fix,ci-failure"
