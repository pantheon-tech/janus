{{=<% %>=}}
name: Infra Preview (what-if)

on:
  pull_request:
    paths:
      - 'infra/**'
      - '.github/workflows/infra-preview.yml'

concurrency:
  group: infra-preview-${{ github.event.pull_request.number }}
  cancel-in-progress: true

permissions:
  id-token: write
  contents: read
  pull-requests: write

jobs:
  what-if:
    strategy:
      matrix:
        env: [staging, prod]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: ${{ matrix.env }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2

      - uses: azure/login@2dd0bbf4064d5a1812889dc200bb8eed2597f82a  # v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Bicep build
        run: az bicep build --file infra/main.bicep

      - name: What-if
        id: whatif
        run: |
          RESULT=$(az deployment group what-if \
            --resource-group rg-<%workload%>-${{ matrix.env }} \
            --template-file infra/main.bicep \
            --parameters infra/parameters.${{ matrix.env }}.bicepparam \
            --no-pretty-print 2>&1)
          {
            echo "result<<RESULTEOF"
            echo "$RESULT"
            echo "RESULTEOF"
          } >> "$GITHUB_OUTPUT"

      - name: Comment on PR
        uses: actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd  # v8.0.0
        with:
          script: |
            const result = `${{ steps.whatif.outputs.result }}`;
            github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: `### Infra what-if — ${{ matrix.env }}\n\n\`\`\`\n${result.slice(0, 60000)}\n\`\`\``
            });
