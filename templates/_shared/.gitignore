# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.vite/
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Env — never commit
.env
.env.local
.env.development
.env.production
.env.test
!.env.example

# Azure
local.settings.json
.azure/
.azurefunctions/

# Bicep — compiled ARM artifacts (regenerated by `az bicep build`)
infra/main.json
infra/modules/*.json

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/tasks.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/cache/

# Coverage / test output
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright/.cache/

# Temp
.tmp/
.cache/

# Secrets (extra layer — should never reach here but belt-and-braces)
*.pem
*.key
*.p12
*.pfx
