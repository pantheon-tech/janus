# Consistent line endings
* text=auto eol=lf

# Lockfiles — union merge
pnpm-lock.yaml merge=union
package-lock.json merge=union

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Generated — collapse in diff view
*.min.js linguist-generated
*.min.css linguist-generated
dist/* linguist-generated
build/* linguist-generated
docs/reference/openapi.json linguist-generated
