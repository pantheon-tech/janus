# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=          # user-assigned managed identity client id (for local az login)

# --- Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Key Vault ---
KEY_VAULT_URI=            # https://kv-<workload>-staging.vault.azure.net/

# --- Database (Cosmos DB example) ---
COSMOS_ENDPOINT=
COSMOS_KEY=               # local dev only; prod uses managed identity

# --- Functions runtime ---
AzureWebJobsStorage=      # storage connection string (or 'UseDevelopmentStorage=true' locally)
FUNCTIONS_WORKER_RUNTIME=node
FUNCTIONS_EXTENSION_VERSION=~4

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
