{
  "name": "janus",
  "version": "0.1.0",
  "description": "Portable project starter kit for TypeScript + Azure solo-dev work",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "biome check .",
