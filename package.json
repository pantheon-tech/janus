{
  "name": "@pantheon-tech/janus",
  "version": "0.1.0",
  "description": "Portable project starter kit for TypeScript + Azure solo-dev work — scaffolds projects and bootstraps Claude Code user-scope",
  "type": "module",
  "bin": {
    "janus": "./bin/janus.js"
  },
  "files": [
    "bin",
    "scripts",
    "templates",
    "user-scope",
    "docs/conventions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check biome.jsonc package.json scripts bin",
    "format": "biome format --write biome.jsonc package.json scripts bin",
    "check": "biome check --write biome.jsonc package.json scripts bin",
    "test": "bash tests/scaffold-smoke-test.sh && bash tests/bootstrap-smoke-test.sh",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.13",
    "@commitlint/cli": "~20.5.0",
    "@commitlint/config-conventional": "~20.5.0",
    "lefthook": "~2.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pantheon-tech/janus.git"
  },
  "homepage": "https://github.com/pantheon-tech/janus#readme",
  "bugs": {
    "url": "https://github.com/pantheon-tech/janus/issues"
  },
  "keywords": [
    "scaffold",
    "starter",
    "typescript",
    "azure",
    "claude-code",
    "monorepo",
    "template"
  ],
  "license": "MIT",
  "author": "Daniel Skipper <daniel@skipper.kiwi>",
  "publishConfig": {
    "access": "public"
  }
}
