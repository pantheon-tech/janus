{
  "name": "janus",
  "version": "0.1.0",
  "description": "Portable project starter kit for TypeScript + Azure solo-dev work",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.13",
    "@commitlint/cli": "~20.5.0",
    "@commitlint/config-conventional": "~20.5.0",
    "lefthook": "~2.1.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skipnz/janus.git"
  },
  "license": "MIT",
  "author": "Daniel Skipper <daniel@skipper.kiwi>"
}
