    "check": "biome check --write .",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "lefthook": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skipnz/janus.git"
  },
